# ──────────────────────────────────────────────────
# INVENTORY SERVICE — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Database ----------------------------------------------------------
# Default: SQLite for local dev. Swap to postgres/asyncpg for real infra.
DATABASE_URL=sqlite+aiosqlite:///./data/inventory.db

# PostgreSQL (uncomment when deploying):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/inventory

# --- FastAPI -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# --- WooCommerce Adapter -----------------------------------------------
WOOD_COMMERCE_URL=https://yourstore.com
WOOD_COMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOD_COMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# --- Mercado Livre Adapter ---------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/v1/mercadolivre/callback
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_USER_ID=0
ML_DEFAULT_CATEGORY=MLB271793

# --- Shopee Adapter ----------------------------------------------------
SHOPEE_PARTNER_ID=0
SHOPEE_API_KEY=
SHOPEE_REDIRECT_URI=http://localhost:8000/v1/shopee/callback
SHOPEE_SANDBOX=true
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SHOP_ID=0

# --- AI / LLM (Onboarding) ---------------------------------------------
# OpenAI-compatible API (9Router, OpenAI, Anthropic, etc.)
AI_API_URL=http://localhost:20128
AI_API_KEY=sk-your-key
AI_MODEL=gpt-4o
AI_MAX_IMAGES=4

# --- OSPOS (Open Source Point of Sale) ---------------------------------
OSPOS_DB_HOST=localhost
OSPOS_DB_PORT=3306
OSPOS_DB_NAME=ospos
OSPOS_DB_USER=root
OSPOS_DB_PASS=
OSPOS_API_URL=

# --- CDC Agent ---------------------------------------------------------
CDC_ENABLED=true
CDC_POLL_INTERVAL=30

# --- Logging / Observability -------------------------------------------
LOG_FORMAT=text                 # "text" or "json" (JSON for production log aggregators)
METRICS_ENABLED=true            # Enable /metrics Prometheus endpoint
SENTRY_DSN=
OTEL_ENABLED=false

# --- Proxy Pool (optional, for rotating IPs) ---------------------------
PROXY_POOL=                    # Comma-separated: http://user:pass@proxy1:8080,http://proxy2:8080

# --- Rate Limiting (per channel) ---------------------------------------
RATE_LIMIT_ML_PER_HOUR=1000    # Mercado Livre: ~1000 req/h per app
RATE_LIMIT_SHOPEE_PER_DAY=3000 # Shopee: ~3000 req/day
RATE_LIMIT_WC_PER_MINUTE=100   # WooCommerce: varies
RATE_LIMIT_ENABLED=false       # Enable distributed rate limiter

# --- Channel Health Tracking -------------------------------------------
HEALTH_CHECK_INTERVAL=300      # Seconds between health checks per channel

# --- Data Retention / Compliance ---------------------------------------
DATA_RETENTION_DAYS=180        # Auto-delete customer data after N days
COMPLIANCE_MODE=basic          # "basic" or "lgpd" or "gdpr"
