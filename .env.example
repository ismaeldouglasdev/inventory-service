# ──────────────────────────────────────────────────
# INVENTORY SERVICE — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Database ----------------------------------------------------------
# Default: SQLite for local dev. Swap to postgres/asyncpg for real infra.
DATABASE_URL=sqlite+aiosqlite:///./data/inventory.db

# PostgreSQL (uncomment when deploying):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/inventory

# MySQL (uncomment when OSPOS mysql access is needed):
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/inventory

# --- FastAPI -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# --- WooCommerce Adapter -----------------------------------------------
# WooCommerce Store URL (no trailing slash)
WOOD_COMMERCE_URL=https://yourstore.com

# WooCommerce API Credentials (Basic Auth / Consumer Key + Secret)
WOOD_COMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOD_COMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# --- Mercado Livre Adapter ---------------------------------------------
# Get these from https://developers.mercadolivre.com.br/
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/v1/mercadolivre/callback

# After OAuth, the service stores tokens here (use env vars for MVP).
# Fill these after visiting /v1/mercadolivre/auth-url and callback.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_USER_ID=0

# Default ML category ID (fallback when product has no category mapping)
ML_DEFAULT_CATEGORY=MLB271793

# --- OSPOS (Open Source Point of Sale) ---------------------------------
OSPOS_DB_HOST=localhost
OSPOS_DB_PORT=3306
OSPOS_DB_NAME=ospos
OSPOS_DB_USER=root
OSPOS_DB_PASS=

# REST API fallback (only if OSPOS exposes an API — optional)
OSPOS_API_URL=

# --- CDC Agent ---------------------------------------------------------
CDC_ENABLED=true
CDC_POLL_INTERVAL=30

# --- Logging / Observability -------------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
