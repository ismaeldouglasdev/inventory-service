# ──────────────────────────────────────────────────
# INVENTORY SERVICE — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Database ----------------------------------------------------------
# Default: SQLite for local dev. Swap to postgres/asyncpg for real infra.
DATABASE_URL=sqlite+aiosqlite:///./data/inventory.db

# PostgreSQL (uncomment when deploying):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/inventory

# MySQL (uncomment when OSPOS mysql access is needed):
# 
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/inventory

# --- FastAPI -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# --- WooCommerce Adapter -----------------------------------------------
# WooCommerce Store URL (no trailing slash)
WOOD_COMMERCE_URL=https://yourstore.com

# WooCommerce API Credentials (Basic Auth / Consumer Key + Secret)
WOOD_COMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOD_COMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# --- CDC Agent ---------------------------------------------------------
CDC_ENABLED=true
CDC_POLL_INTERVAL=10

# --- OSPOS (Open Source Point of Sale) ---------------------------------
OSPOS_DB_HOST=127.0.0.1
OSPOS_DB_PORT=3306
OSPOS_DB_NAME=ospos
OSPOS_DB_USER=admin
OSPOS_DB_PASS=pointofsale

# --- Mercado Livre -------------------------------------------------
# Preencha CLIENT_ID e CLIENT_SECRET após criar o app no DevCenter
ML_CLIENT_ID=3439612454641866
ML_CLIENT_SECRET=YQ3GOSYnvQsYcWV1uDxNYZYPnMJtxlU8
ML_REDIRECT_URI=https://validity-genuine-linda-chem.trycloudflare.com/v1/mercadolivre/callback
ML_ACCESS_TOKEN=APP_USR-3439612454641866-061923-96dc1bebf142cf58f070d1c2eea0c301-1406803383
ML_REFRESH_TOKEN=TG-6a360c76808ad7000189ecb6-1406803383
ML_USER_ID=1406803383

# --- Logging / Observability -------------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
